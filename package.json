{
  "$schema": "https://json.schemastore.org/package",
  "name": "strapi-plugin-io",
  "version": "3.0.0",
  "description": "A plugin for Strapi CMS that provides the ability for Socket IO integration",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "plugin",
    "strapi plugin",
    "socket",
    "socket io",
    "io"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "types.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "strapi-plugin build && node scripts/build-server-bundle.mjs && npm run verify:runtime",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"./**/*.{js,json,yml,md}\""
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^6.3.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "sharp": "0.35.5",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.57.0",
    "esbuild": "^0.28.2",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.57.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "name": "io",
    "displayName": "IO",
    "description": "A plugin for Strapi CMS that provides the ability for Socket IO integration",
    "kind": "plugin"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "author": {
    "name": "@ComfortablyCoding",
    "url": "https://github.com/ComfortablyCoding"
  },
  "maintainers": [
    {
      "name": "@ComfortablyCoding",
      "url": "https://github.com/ComfortablyCoding",
      "lead": true
    },
    {
      "name": "@hrdunn",
      "url": "https://github.com/hrdunn"
    }
  ],
  "homepage": "https://github.com/Schero94/strapi-plugin-io#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schero94/strapi-plugin-io.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/strapi-plugin-io/issues"
  },
  "license": "MIT"
}
